{
  "name": "smart-library-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "knex migrate:latest --knexfile knexfile.js --env development",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.js --env development",
    "db:seed": "knex seed:run --knexfile knexfile.js --env development",
    "db:status": "knex migrate:list --knexfile knexfile.js --env development",
    "db:check": "node scripts/check-db.js",
    "user:create": "node scripts/create-user.js",
    "test:backend": "node --test tests/backend-foundations.test.js tests/phase2-backend.test.js"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "knex": "^3.3.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.3"
  }
}
